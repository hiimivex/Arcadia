#include "winresrc.h"
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
LICHII_ICON               ICON                    "../../dist/arcadia.ico"


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

0                       RT_MANIFEST             "../../dist/lichii.manifest"

// Arcadia : nom affiché par Windows (barre des tâches, mélangeur de volume)
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Arcadia"
            VALUE "FileDescription", "Arcadia"
            VALUE "ProductName", "Arcadia"
            VALUE "InternalName", "arcadia-switch"
            VALUE "OriginalFilename", "arcadia-switch.exe"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
            VALUE "LegalCopyright", "GPL-3.0 - moteur Switch base sur Lichii, Eden et yuzu"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
